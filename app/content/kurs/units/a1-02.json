  "lines": [
   {
    "r": "A",
    "de": "Schau mal, das ist meine Familie.",
    "tr": "Bak, bu benim ailem."
   },
   {
    "r": "B",
    "de": "Oh, schön! Ist das deine Mutter?",
    "tr": "Aa, ne güzel! Bu senin annen mi?"
   },
   {
    "r": "A",
    "de": "Ja, sie ist zweiundsechzig und wohnt in Passau.",
    "tr": "Evet, altmış iki yaşında ve Passau'da oturuyor."
   },
   {
    "r": "B",
    "de": "Und wer ist das? Dein Bruder?",
    "tr": "Peki bu kim? Erkek kardeşin mi?"
   },
   {
    "r": "A",
    "de": "Nein, das ist mein Mann, Murat. Er kommt aus der Türkei.",
    "tr": "Hayır, bu benim kocam, Murat. Türkiyeli."
   },
   {
    "r": "B",
    "de": "Ach so! Sprecht ihr zu Hause Türkisch?",
    "tr": "Anladım! Evde Türkçe mi konuşuyorsunuz?"
   },
   {
    "r": "A",
    "de": "Ja, und Deutsch. Die Kinder sprechen beide Sprachen.",
    "tr": "Evet, Almanca da. Çocuklar iki dili de konuşuyor."
   },
   {
    "r": "B",
    "de": "Toll! Wie alt sind die Kinder?",
    "tr": "Harika! Çocuklar kaç yaşında?"
   },
   {
    "r": "A",
    "de": "Mia ist sieben und Emil ist vier.",
    "tr": "Mia yedi, Emil dört yaşında."
   },
   {
    "r": "B",
    "de": "Wirklich süß!",
    "tr": "Gerçekten çok tatlılar!"
   }
  ]
 },
