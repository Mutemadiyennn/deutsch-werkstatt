  "id": "m1:02:v1",
  "title_tr": "Ayları doğru söylemek",
  "sahneler": [
   {
    "id": "s1",
    "speaker": "ch:petrovic",
    "sahne_tr": "Kuaför salonu. Luka makasla Ioana'nın saçını kesiyor, ikisi aynada görünüyor.",
    "de": "Hallo Ioana! Wann haben Sie Urlaub?",
    "tr": "Merhaba Ioana! İzniniz ne zaman?"
   },
   {
    "id": "s2",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana aynaya bakıp konuşuyor. Luka o sırada saç kurutma makinesini çalıştırıyor.",
    "de": "Ich habe im August Urlaub.",
    "tr": "Ağustosta iznim var."
   },
   {
    "id": "s3",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka makineyi kapatıyor, iyi duyamamış gibi başını Ioana'ya doğru eğiyor.",
    "de": "Im Oktober?",
    "tr": "Ekimde mi?"
   },
   {
    "id": "s4",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana gülüyor, duvardaki takvimde ağustosu gösteriyor.",
    "de": "Nein, nicht im Oktober. Im August!",
    "tr": "Hayır, ekimde değil. Ağustosta!"
   },
   {
    "id": "s5",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana cümleyi yavaşça ve dikkatle yeniden söylüyor.",
    "de": "Ich habe im August Urlaub.",
    "tr": "Ağustosta iznim var."
   },
   {
    "id": "s6",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka başparmağını kaldırıyor, aynanın köşesinde bir güneş çizimi beliriyor.",
    "de": "Ja, im August! Im Sommer.",
    "tr": "Evet, ağustosta! Yazın."
   },
   {
    "id": "s7",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana aynadan Luka'ya bakıyor.",
    "de": "Und Sie, Luka? Wann haben Sie Urlaub?",
    "tr": "Ya siz, Luka? Sizin izniniz ne zaman?"
   },
   {
    "id": "s8",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka'nın başının üstünde karlı bir dağ çizimi beliriyor.",
    "de": "Ich habe im Januar Urlaub. Im Winter!",
    "tr": "Ocakta iznim var. Kışın!"
   },
   {
    "id": "s9",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana duvardaki takvimin ilk sayfasını gösteriyor.",
    "de": "Anfang Januar?",
    "tr": "Ocak başında mı?"
   },
   {
    "id": "s10",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka takvimde ocağın son haftasını gösteriyor.",
    "de": "Nein, Ende Januar.",
    "tr": "Hayır, ocak sonunda."
   },
   {
    "id": "s11",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana gururla kendini gösteriyor.",
    "de": "Mein Geburtstag ist im Mai.",
    "tr": "Doğum günüm mayısta."
   },
   {
    "id": "s12",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka alkışlıyor, aynanın köşesinde çiçek çizimi beliriyor.",
    "de": "Ach, im Mai! Im Frühling.",
    "tr": "Ha, mayısta! İlkbaharda."
   },
   {
    "id": "s13",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana koltukta Luka'ya doğru dönüyor.",
    "de": "Und Sie? Wann haben Sie Geburtstag?",
    "tr": "Ya siz? Sizin doğum gününüz ne zaman?"
   },
   {
    "id": "s14",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka omuz silkip utangaç bir şekilde gülümsüyor.",
    "de": "Heute!",
    "tr": "Bugün!"
   },
   {
    "id": "s15",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana koltuktan fırlıyor, kollarını açıyor.",
    "de": "Heute? Alles Gute zum Geburtstag, Luka!",
    "tr": "Bugün mü? Doğum günün kutlu olsun, Luka!"
   },
   {
    "id": "s16",
    "speaker": "ch:petrovic",
    "sahne_tr": "Luka elini kalbine koyuyor.",
    "de": "Danke, Ioana!",
    "tr": "Teşekkürler, Ioana!"
   },
   {
    "id": "s17",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana yeni saçıyla aynaya dönüyor, üç parmağını gösteriyor.",
    "de": "Im Januar, im Mai, im Sommer. Im!",
    "tr": "Ocakta, mayısta, yazın. **Im!**"
   }
