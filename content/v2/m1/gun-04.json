    "de": "Ach, vier Euro achtzig! Ich zahle mit Karte.",
    "tr": "Ha, dört avro seksen! Kartla ödüyorum."
   },
   {
    "id": "s7",
    "speaker": "ch:stadler",
    "sahne_tr": "Frau Stadler elinde bir kâğıt poşet tutuyor.",
    "de": "Gern. Eine Tüte?",
    "tr": "Tabii. Poşet ister misiniz?"
   },
   {
    "id": "s8",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana gülümseyerek kendi bez çantasını gösteriyor.",
    "de": "Nein, danke.",
    "tr": "Hayır, teşekkürler."
   },
   {
    "id": "s9",
    "speaker": "ch:popescu",
    "sahne_tr": "Meydandaki meyve tezgâhında Ioana, elma seçen Frau Brandl'ı görüyor.",
    "de": "Hallo, Frau Brandl! Was kostet ein Apfel hier?",
    "tr": "Merhaba Frau Brandl! Burada bir elma ne kadar?"
