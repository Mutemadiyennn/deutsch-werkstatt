   {
    "id": "s10",
    "speaker": "ch:brandl",
    "sahne_tr": "Frau Brandl elindeki kırmızı elmayı havaya kaldırıyor.",
    "de": "Ein Apfel kostet fünfzig Cent.",
    "tr": "Bir elma elli sent."
   },
   {
    "id": "s11",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana başını sallıyor, sepetine bir elma koyuyor.",
    "de": "Das ist nicht teuer!",
    "tr": "Bu pahalı değil!"
   },
   {
    "id": "s12",
    "speaker": "ch:brandl",
    "sahne_tr": "Frau Brandl merakla Ioana'ya doğru eğiliyor.",
    "de": "Wie alt sind Sie, Ioana?",
