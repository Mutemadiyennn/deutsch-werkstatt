  "sahneler": [
   {
    "id": "s1",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana cumartesi sabahı şehir meydanında telefonuna el sallıyor.",
    "de": "Hallo, hier ist Ioana! Heute ist Samstag.",
    "tr": "Merhaba, ben Ioana! Bugün cumartesi."
   },
   {
    "id": "s2",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana fırının tezgâhında ekmekleri gösteriyor.",
    "de": "Guten Tag, Frau Stadler! Zwei Semmeln und ein Brot, bitte.",
    "tr": "İyi günler Frau Stadler! İki küçük ekmek ve bir ekmek, lütfen."
   },
   {
    "id": "s3",
    "speaker": "ch:stadler",
    "sahne_tr": "Frau Stadler ekmekleri poşetin yanına koyuyor, kasaya bakıyor.",
    "de": "Gern! Das macht vier Euro achtzig.",
    "tr": "Memnuniyetle! Toplam dört avro seksen."
   },
   {
    "id": "s4",
    "speaker": "ch:popescu",
    "sahne_tr": "Ioana'nın gözleri büyüyor, elini başına götürüyor.",
    "de": "Vierzig Euro? Das ist zu teuer!",
    "tr": "Kırk avro mu? Bu çok pahalı!"
   },
   {
    "id": "s5",
    "speaker": "ch:stadler",
    "sahne_tr": "Frau Stadler gülerek kasadaki sayıları gösteriyor.",
    "de": "Nein, nicht vierzig! Vier Euro achtzig.",
    "tr": "Hayır, kırk değil! Dört avro seksen."
   },
   {
    "id": "s6",
    "speaker": "ch:popescu",
